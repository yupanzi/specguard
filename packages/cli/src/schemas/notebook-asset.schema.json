{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specguard.dev/schemas/notebook-asset.schema.json",
  "title": "specguard notebook asset frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "kind", "scope", "version", "source_change_id", "source_date"],
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["index", "topic"] },
    "scope": {
      "enum": ["notebook", "notebook.knowledge", "notebook.skill", "notebook.check"]
    },
    "version": { "type": "integer", "minimum": 1 },
    "source_change_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "source_date": { "type": "string", "pattern": "^\\d{8}$" },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id", "file", "when"],
        "properties": {
          "ref_id": { "type": "string", "pattern": "^[KSC]-\\d{2}$" },
          "file": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ref_id": { "type": "string", "pattern": "^[KSC]-\\d{2}$" },
    "library": { "enum": ["knowledge", "skill", "check"] },
    "supersedes": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "index" } },
        "required": ["kind"]
      },
      "then": { "required": ["references"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "topic" } },
        "required": ["kind"]
      },
      "then": { "required": ["ref_id", "library"] }
    }
  ]
}
