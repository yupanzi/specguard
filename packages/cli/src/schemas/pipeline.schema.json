{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specguard.dev/schemas/run.schema.json",
  "title": "specguard run",
  "type": "object",
  "required": ["id", "attempts"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "at", "task_results"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "at": { "type": "string", "minLength": 1 },
          "task_results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["pending", "in_progress", "pass", "fail"] },
                "started": { "type": "string" },
                "ended": { "type": "string" },
                "log": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
