{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specguard.dev/schemas/spec.schema.json",
  "title": "specguard spec",
  "type": "object",
  "required": ["version", "id", "goal", "asks", "checks"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "spec version; increments on re-spec"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "kebab-case change id"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "one-line statement of intent"
    },
    "asks": {
      "type": "array",
      "description": "ambiguities resolved with user during /sg-spec-ask",
      "items": {
        "type": "object",
        "required": ["q", "a"],
        "additionalProperties": false,
        "properties": {
          "q": { "type": "string", "minLength": 1 },
          "a": { "type": "string", "minLength": 1 },
          "level": { "enum": ["blocker", "defer"] }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "acceptance criteria with verification method",
      "items": {
        "type": "object",
        "required": ["id", "what", "how"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 1 },
          "how": {
            "description": "exactly one of cmd (string array, spawn'd directly without shell) | llm (prompt string) | manual (instruction string)",
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "llm": { "type": "string", "minLength": 1 },
              "manual": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
