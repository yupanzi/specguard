{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specguard.dev/schemas/plan.schema.json",
  "title": "specguard plan",
  "type": "object",
  "required": ["version", "id", "files", "approach"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "plan version; increments on re-plan"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "kebab-case change id; must equal spec.id"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "files involved in this plan (relative paths from repo root)",
      "items": { "type": "string", "minLength": 1 }
    },
    "approach": {
      "type": "string",
      "minLength": 1,
      "description": "implementation path and rationale"
    },
    "tradeoffs": {
      "type": "string",
      "description": "optional: design tradeoffs considered (alternatives rejected and why)"
    }
  }
}
